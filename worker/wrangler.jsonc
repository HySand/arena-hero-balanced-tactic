{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arena-hero-balanced-tactic",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/control"],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [
      {
        "binding": "COMMAND_QUEUE",
        "queue": "arena-hero-command-submissions",
      },
    ],
    "consumers": [
      {
        "queue": "arena-hero-command-submissions",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 2,
        "max_concurrency": 1,
        "retry_delay": 1,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT",
        "class_name": "ArenaHeroAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaHeroAgent"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
