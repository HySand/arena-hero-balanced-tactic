{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arena-hero-balanced-tactic",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT",
        "class_name": "ArenaHeroAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaHeroAgent"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
