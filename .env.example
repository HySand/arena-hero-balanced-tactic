# Copy your current Arena Hero API key after the equals sign.
# Keep .env local and never commit it.
ARENA_HERO_API_KEY=
# Must match the username shown in the Arena web app account menu.
ARENA_HERO_EXPECTED_USERNAME=

# Normal users can keep these defaults.
TACTIC_PROFILE=economy
TACTIC_SAFETY=1
TACTIC_CORE_MIGRATION=1
TACTIC_DEBUG=1

# Compatibility checks fail closed when the reviewed contract drifts.
ARENA_HERO_VERSION_CHECK=1
ARENA_HERO_VERSION_CHECK_INTERVAL_TICKS=240

# Optional persistent paths for external deployments.
# Local defaults already live under this project's data/ directory.
# ARENA_HERO_CONFIG_FILE=/data/runtime/strategy_config.json
# ARENA_HERO_STATE_FILE=/data/runtime/state/tactic_state.json
# ARENA_HERO_DASHBOARD_STATE_FILE=/data/runtime/state/dashboard_state.json
# ARENA_HERO_TACTIC_LOCK_FILE=/data/runtime/locks/tactic.lock
# ARENA_HERO_DASHBOARD_LOCK_FILE=/data/runtime/locks/dashboard.lock
# ARENA_HERO_TRAINING_FILE=/data/training/turns.jsonl
# ARENA_HERO_TRAINING_SOURCE_FILE=/data/training/source.json
# ARENA_HERO_ECONOMY_TELEMETRY_FILE=/data/training/peace_economy_telemetry.jsonl
# ARENA_HERO_EXPERIMENT_STATE_FILE=/data/runtime/state/peace_economy_experiment_state.json
# ARENA_HERO_COMPAT_MARKER=/data/runtime/state/compatibility_hold.json
# ARENA_HERO_COMPAT_REPORT=/data/runtime/state/version_report.json
